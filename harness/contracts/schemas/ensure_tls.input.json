{
  "$defs": {
    "Target": {
      "description": "배포 대상 환경. 실행기가 plan.json의 트랙과 deploy.yaml로 정한다(AI가 고르지 않는다).",
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Target",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "lock_token": {
      "description": "acquire_deploy_lock이 발급한 토큰",
      "maxLength": 128,
      "minLength": 8,
      "title": "Lock Token",
      "type": "string"
    },
    "mode": {
      "default": "check",
      "enum": [
        "check",
        "apply"
      ],
      "title": "Mode",
      "type": "string"
    },
    "run_id": {
      "description": "실행 ID. 모든 툴의 필수 입력",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    }
  },
  "required": [
    "run_id",
    "target",
    "lock_token"
  ],
  "title": "EnsureTlsInput",
  "type": "object"
}
