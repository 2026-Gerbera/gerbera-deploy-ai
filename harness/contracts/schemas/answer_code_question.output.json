{
  "$defs": {
    "AIUsage": {
      "additionalProperties": false,
      "description": "AI 툴 출력에 붙이는 사용량. 💭 필드 확정은 계약 문서(TODO(contract)).",
      "properties": {
        "cost_usd": {
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "latency_ms"
      ],
      "title": "AIUsage",
      "type": "object"
    },
    "Source": {
      "description": "AI 결과의 출처. live가 아니면 관리 페이지가 라벨을 표시한다(목업은 목업이라고 밝힘).",
      "enum": [
        "live",
        "cache",
        "fixture",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ai_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/AIUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Commit",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "answer",
    "commit"
  ],
  "title": "AnswerCodeQuestionOutput",
  "type": "object"
}
