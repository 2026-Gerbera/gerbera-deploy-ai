{
  "$defs": {
    "DeployRequest": {
      "additionalProperties": false,
      "properties": {
        "code_patch": {
          "default": false,
          "title": "Code Patch",
          "type": "boolean"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "mode": {
          "$ref": "#/$defs/RunMode",
          "default": "update"
        },
        "project": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "repo_url": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Repo Url",
          "type": "string"
        },
        "target": {
          "enum": [
            "local",
            "cloud",
            "both"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "project",
        "repo_url",
        "target"
      ],
      "title": "DeployRequest",
      "type": "object"
    },
    "FileMeta": {
      "additionalProperties": false,
      "description": "core/store.release_view 의 파일 항목과 같은 모양.",
      "properties": {
        "executable": {
          "title": "Executable",
          "type": "boolean"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "executable"
      ],
      "title": "FileMeta",
      "type": "object"
    },
    "RunMode": {
      "description": "run 종류. 초기 배포도 같은 파이프라인으로 한다(✅ 장부 14).",
      "enum": [
        "update",
        "bootstrap"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "SnapshotBinding": {
      "additionalProperties": false,
      "properties": {
        "build_snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Snapshot Hash",
          "type": "string"
        },
        "patch_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Sha256"
        },
        "source_snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Hash",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_hash",
        "build_snapshot_hash"
      ],
      "title": "SnapshotBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "previous": {
      "additionalProperties": {
        "anyOf": [
          {
            "additionalProperties": {
              "$ref": "#/$defs/FileMeta"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "local",
          "cloud"
        ]
      },
      "title": "Previous",
      "type": "object"
    },
    "request": {
      "$ref": "#/$defs/DeployRequest"
    },
    "run_id": {
      "description": "실행 ID. 모든 툴의 필수 입력",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotBinding"
    },
    "source_dir": {
      "title": "Source Dir",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "request",
    "source_dir",
    "snapshot",
    "previous"
  ],
  "title": "DetectChangedTiersInput",
  "type": "object"
}
