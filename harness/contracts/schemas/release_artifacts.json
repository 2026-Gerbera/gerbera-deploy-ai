{
  "$defs": {
    "ImageArtifact": {
      "additionalProperties": false,
      "properties": {
        "index_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Index Digest",
          "type": "string"
        },
        "platform_digests": {
          "additionalProperties": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          },
          "title": "Platform Digests",
          "type": "object"
        },
        "ref": {
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "index_digest",
        "platform_digests"
      ],
      "title": "ImageArtifact",
      "type": "object"
    },
    "ImageObservation": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ],
          "title": "Platform",
          "type": "string"
        },
        "platform_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Platform Digest",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "platform_digest"
      ],
      "title": "ImageObservation",
      "type": "object"
    },
    "SnapshotBinding": {
      "additionalProperties": false,
      "properties": {
        "build_snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Build Snapshot Hash",
          "type": "string"
        },
        "patch_sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Sha256"
        },
        "source_snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Hash",
          "type": "string"
        }
      },
      "required": [
        "source_snapshot_hash",
        "build_snapshot_hash"
      ],
      "title": "SnapshotBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "images": {
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,31}$": {
          "$ref": "#/$defs/ImageArtifact"
        }
      },
      "propertyNames": {
        "description": "deploy.yaml에 정의된 tier"
      },
      "title": "Images",
      "type": "object"
    },
    "observations": {
      "additionalProperties": {
        "patternProperties": {
          "^[a-z][a-z0-9_-]{0,31}$": {
            "$ref": "#/$defs/ImageObservation"
          }
        },
        "propertyNames": {
          "description": "deploy.yaml에 정의된 tier"
        },
        "type": "object"
      },
      "propertyNames": {
        "enum": [
          "local",
          "cloud"
        ]
      },
      "title": "Observations",
      "type": "object"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotBinding"
    }
  },
  "required": [
    "snapshot",
    "images"
  ],
  "title": "ReleaseArtifacts",
  "type": "object"
}
