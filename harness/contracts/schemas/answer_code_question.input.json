{
  "$defs": {
    "CodeFile": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 60000,
          "title": "Content",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "CodeFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "branch": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Branch",
      "type": "string"
    },
    "commit": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Commit",
      "type": "string"
    },
    "files": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CodeFile"
      },
      "maxItems": 80,
      "title": "Files",
      "type": "array"
    },
    "paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 3000,
      "title": "Paths",
      "type": "array"
    },
    "question": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "run_id": {
      "description": "실행 ID. 모든 툴의 필수 입력",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "question",
    "commit",
    "branch"
  ],
  "title": "AnswerCodeQuestionInput",
  "type": "object"
}
