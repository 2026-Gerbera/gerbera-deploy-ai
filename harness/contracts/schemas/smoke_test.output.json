{
  "$defs": {
    "SmokeScenario": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "maxLength": 200,
          "title": "Detail",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Z][A-Za-z0-9_.-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "normalized": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Normalized",
          "type": "object"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "id",
        "ok"
      ],
      "title": "SmokeScenario",
      "type": "object"
    },
    "Target": {
      "description": "배포 대상 환경. 실행기가 plan.json의 트랙과 deploy.yaml로 정한다(AI가 고르지 않는다).",
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Target",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "elapsed_s": {
      "minimum": 0,
      "title": "Elapsed S",
      "type": "number"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "run_id": {
      "description": "실행 ID. 모든 툴의 필수 입력",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/SmokeScenario"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "source": {
      "default": "live",
      "enum": [
        "live",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    }
  },
  "required": [
    "run_id",
    "target",
    "passed",
    "elapsed_s",
    "scenarios"
  ],
  "title": "SmokeTestOutput",
  "type": "object"
}
