{
  "$defs": {
    "By": {
      "description": "결정 주체. 계획 step·패치 등을 규칙이 정했는지 AI가 정했는지 표시한다.",
      "enum": [
        "rule",
        "ai"
      ],
      "title": "By",
      "type": "string"
    },
    "EnvKey": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/By",
          "default": "rule"
        },
        "is_new": {
          "default": true,
          "title": "Is New",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "plain",
            "secret"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "name": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tier": {
          "anyOf": [
            {
              "description": "deploy.yaml에 정의된 tier",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "title": "EnvKey",
      "type": "object"
    },
    "Facts": {
      "additionalProperties": false,
      "properties": {
        "changed": {
          "additionalProperties": {
            "patternProperties": {
              "^[a-z][a-z0-9_-]{0,31}$": {
                "type": "boolean"
              }
            },
            "propertyNames": {
              "description": "deploy.yaml에 정의된 tier"
            },
            "type": "object"
          },
          "propertyNames": {
            "enum": [
              "local",
              "cloud"
            ]
          },
          "title": "Changed",
          "type": "object"
        },
        "code_patch": {
          "default": false,
          "title": "Code Patch",
          "type": "boolean"
        },
        "db_initialized": {
          "additionalProperties": {
            "type": "boolean"
          },
          "propertyNames": {
            "enum": [
              "local",
              "cloud"
            ]
          },
          "title": "Db Initialized",
          "type": "object"
        },
        "env_keys": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnvKey"
          },
          "title": "Env Keys",
          "type": "array"
        },
        "facts_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Facts Hash",
          "type": "string"
        },
        "has_dockerfile": {
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,31}$": {
              "type": "boolean"
            }
          },
          "propertyNames": {
            "description": "deploy.yaml에 정의된 tier"
          },
          "title": "Has Dockerfile",
          "type": "object"
        },
        "infra_inputs_changed": {
          "default": false,
          "title": "Infra Inputs Changed",
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/RunMode"
        },
        "modified_migrations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Modified Migrations",
          "type": "array"
        },
        "new_migrations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "New Migrations",
          "type": "array"
        },
        "patch_targets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PatchTarget"
          },
          "title": "Patch Targets",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "smoke_groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Smoke Groups",
          "type": "array"
        },
        "source_snapshot_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Hash",
          "type": "string"
        },
        "target": {
          "enum": [
            "local",
            "cloud",
            "both"
          ],
          "title": "Target",
          "type": "string"
        },
        "tiers": {
          "items": {
            "description": "deploy.yaml에 정의된 tier",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$",
            "type": "string"
          },
          "title": "Tiers",
          "type": "array"
        }
      },
      "required": [
        "project",
        "mode",
        "target",
        "tiers",
        "changed",
        "source_snapshot_hash",
        "facts_hash"
      ],
      "title": "Facts",
      "type": "object"
    },
    "PatchTarget": {
      "additionalProperties": false,
      "description": "정적 탐지 위치와 키 이름만 전달한다. 원문·값은 계약에 포함하지 않는다.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "is_new": {
          "title": "Is New",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "pattern_id": {
          "title": "Pattern Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "patch",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "pattern_id",
        "is_new",
        "severity"
      ],
      "title": "PatchTarget",
      "type": "object"
    },
    "RunMode": {
      "description": "run 종류. 초기 배포도 같은 파이프라인으로 한다(✅ 장부 14).",
      "enum": [
        "update",
        "bootstrap"
      ],
      "title": "RunMode",
      "type": "string"
    },
    "Source": {
      "description": "AI 결과의 출처. live가 아니면 관리 페이지가 라벨을 표시한다(목업은 목업이라고 밝힘).",
      "enum": [
        "live",
        "cache",
        "fixture",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "facts": {
      "$ref": "#/$defs/Facts"
    },
    "feedback": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Feedback",
      "type": "array"
    },
    "run_id": {
      "description": "실행 ID. 모든 툴의 필수 입력",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "facts"
  ],
  "title": "GeneratePlanInput",
  "type": "object"
}
