{
  "$defs": {
    "ApprovedPatch": {
      "additionalProperties": false,
      "description": "이전 run에서 승인된 패치(재사용 후보). 실행기 승인 기록의 patch·patch_meta에서 온다.",
      "properties": {
        "patch": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Patch",
          "type": "string"
        },
        "reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "default": "live"
        }
      },
      "required": [
        "patch",
        "reason"
      ],
      "title": "ApprovedPatch",
      "type": "object"
    },
    "CodeProposal": {
      "additionalProperties": false,
      "properties": {
        "edits": {
          "items": {
            "$ref": "#/$defs/ReviewEdit"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Edits",
          "type": "array"
        },
        "env_vars": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Env Vars",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "requires": {
          "items": {
            "pattern": "^[a-z0-9_-]{1,64}$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Requires",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "reason",
        "edits"
      ],
      "title": "CodeProposal",
      "type": "object"
    },
    "PatchReviewRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "propose",
            "revise",
            "compose"
          ],
          "title": "Action",
          "type": "string"
        },
        "prompt": {
          "default": "",
          "maxLength": 2000,
          "title": "Prompt",
          "type": "string"
        },
        "proposal_id": {
          "default": "",
          "title": "Proposal Id",
          "type": "string"
        },
        "proposals": {
          "items": {
            "$ref": "#/$defs/CodeProposal"
          },
          "maxItems": 10,
          "title": "Proposals",
          "type": "array"
        },
        "selected": {
          "items": {
            "pattern": "^[a-z0-9_-]{1,64}$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Selected",
          "type": "array"
        }
      },
      "required": [
        "action"
      ],
      "title": "PatchReviewRequest",
      "type": "object"
    },
    "ReviewEdit": {
      "additionalProperties": false,
      "description": "PatchEdit와 동일한 줄 범위·길이 제한. 번호는 변경 전 원본 기준이다.",
      "properties": {
        "end": {
          "maximum": 100000,
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Lines",
          "type": "array"
        },
        "path": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "start": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start",
        "end",
        "lines"
      ],
      "title": "ReviewEdit",
      "type": "object"
    },
    "Source": {
      "description": "AI 결과의 출처. live가 아니면 관리 페이지가 라벨을 표시한다(목업은 목업이라고 밝힘).",
      "enum": [
        "live",
        "cache",
        "fixture",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "source_dir은 intake가 만든 prod 원본 스냅샷(DDAK_SOURCES_DIR 기준 상대 경로).",
  "properties": {
    "previous": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovedPatch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/PatchReviewRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "description": "실행 ID. 모든 툴의 필수 입력",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "source_dir": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Dir",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "source_dir"
  ],
  "title": "PatchConfigInput",
  "type": "object"
}
