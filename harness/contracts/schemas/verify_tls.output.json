{
  "$defs": {
    "Target": {
      "description": "배포 대상 환경. 실행기가 plan.json의 트랙과 deploy.yaml로 정한다(AI가 고르지 않는다).",
      "enum": [
        "local",
        "cloud"
      ],
      "title": "Target",
      "type": "string"
    },
    "TlsCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "maxLength": 400,
          "title": "Detail",
          "type": "string"
        },
        "id": {
          "enum": [
            "V1",
            "V2",
            "V3",
            "V4",
            "V5",
            "V6",
            "V7",
            "V8",
            "V9"
          ],
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "title": "TlsCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/TlsCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "elapsed_s": {
      "minimum": 0,
      "title": "Elapsed S",
      "type": "number"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "run_id": {
      "description": "실행 ID. 모든 툴의 필수 입력",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    }
  },
  "required": [
    "run_id",
    "target",
    "passed",
    "checks",
    "elapsed_s"
  ],
  "title": "VerifyTlsOutput",
  "type": "object"
}
