# 환경변수 키 목록(값 없음). 실제 값은 .env(커밋 금지) 또는 공유 금고에 둔다.
# 파일 이름을 .env.example이 아닌 env.example로 한 이유: .env.* 읽기 차단 규칙에 걸리지 않게.
# 키 목록은 고려안(💭)이다. 확정은 docs/contracts/ 계약 문서가 한다.
# 기준: 앱 1개 구조(🟡 팀 합의 대기, docs/18). 한 프로세스라 모든 키가 같은 프로세스에 보인다.

# ---- 실행 모드 ----
DDAK_ADAPTER_MODE=fake
DDAK_DEPLOY_CONFIG=fixtures/deploy.yaml
DDAK_RUN_DIR=var/runs
DDAK_LOG_LEVEL=INFO

# ---- AI: call_ai backend (✅ cli | api | replay) ----
# cli: 개발. 운영자 본인 로컬에 로그인해 둔 Claude CLI(구독). 외부 공개·서버·컨테이너에서 쓰지 않는다.
# api: 데모(외부 공개 포함). DDAK_LLM_API_KEY 필요.
# replay: 테스트·비상. 저장된 응답(fixtures/ai_replay/). 기본값.
DDAK_LLM_BACKEND=replay
# 💭 실측으로 선택(예: claude-sonnet-5-5, claude-opus-5-5). 날짜 접미사를 붙이지 않는다.
DDAK_LLM_MODEL=
DDAK_CLAUDE_BIN=claude
# api backend 전용. 값은 공유 금고에만 둔다(채팅·Notion에 붙여넣지 않는다).
# 이름을 ANTHROPIC_API_KEY로 하지 않는 이유: claude -p는 그 변수가 있으면 구독 대신 키를 쓴다.
DDAK_LLM_API_KEY=
DDAK_AI_TIMEOUT_S=20
DDAK_AI_RETRIES=1
DDAK_AI_BUDGET_USD_PER_RUN=
DDAK_AI_REPLAY_DIR=fixtures/ai_replay
# Jev(✅ 팀이 키 보유). 버전 고정, 타임아웃 2초·재시도 1회.
DDAK_JEV_API_KEY=
DDAK_JEV_MODEL=jev-1.13.0
DDAK_JEV_TIMEOUT_S=2

# ---- AWS (키 대신 프로필 이름만) ----
AWS_PROFILE=ddak-dev
AWS_REGION=ap-northeast-2
# 검증 툴용 읽기 전용 프로필. 비어 있으면 ddak-readonly로 고정(쓰기 프로필로 떨어지지 않게).
DDAK_AWS_READONLY_PROFILE=ddak-readonly

# ---- 이미지 저장소 (✅ 9/30: 기본 Docker Hub, ECR은 옵션 어댑터) ----
DDAK_REGISTRY=dockerhub
# 조직 또는 개인 네임스페이스(무료 플랜 비공개 저장소 수·pull 제한은 확인 필요)
DDAK_DOCKERHUB_NAMESPACE=
# 토큰 값은 여기 적지 않는다. CodeBuild·ECS는 Secrets Manager 시크릿 이름만 안다(💭 이름):
#   ddak-platform/dockerhub-push  읽기·쓰기 토큰. CodeBuild 서비스 역할만 읽음
#   ddak-platform/dockerhub-pull  읽기 전용 토큰. ECS 실행 역할 repositoryCredentials
# 온프렘 호스트는 읽기 전용 토큰으로 docker login(김준석 프로비저닝, AWS 자격 불필요).

# ---- Slack (💭 P0-라이트: Incoming Webhook, 단방향 알림) ----
# 웹훅 URL은 비밀이다. 값 대신 파일 경로만(.secrets/는 gitignore).
DDAK_SLACK_WEBHOOK_FILE=

# ---- 관리 페이지 (127.0.0.1에만 바인드) ----
# 온프렘 앱 기본 주소 http://localhost:8080과 겹치지 않게 8765(💭 I-26).
DDAK_ADMIN_PORT=8765

# ---- 로컬(온프렘) 배포 대상 (compose/local, MySQL 8.4) ----
# 로컬 HTTPS는 ⏸ 보류. 기본 주소는 http://localhost:8080.
DDAK_LOCAL_PUBLIC_URL=http://localhost:8080
DDAK_LOCAL_DB_NAME=flaskr
DDAK_LOCAL_DB_USER=flaskr_app
# 비밀번호는 여기 적지 않는다. compose/local/.secrets/ 파일(gitignore)로 넣는다.
# 앱 DATABASE_URL 모양(값 아님, 비밀번호는 URL 인코딩):
#   mysql+pymysql://flaskr_app:<비밀번호>@<db 서버 IP 또는 컨테이너 이름>:3306/flaskr?charset=utf8mb4
